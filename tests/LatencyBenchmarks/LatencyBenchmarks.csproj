<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <SourceRoot Condition="'$(Baseline)' != 'true'">$(MSBuildProjectDirectory)\..\..</SourceRoot>
    <SourceRoot Condition="'$(Baseline)' == 'true'">$(MSBuildProjectDirectory)\obj\baseline</SourceRoot>
    <BaseOutputPath Condition="'$(Baseline)' == 'true'">$(MSBuildProjectDirectory)\bin\baseline\</BaseOutputPath>
    <DefineConstants Condition="'$(Baseline)' == 'true'">$(DefineConstants);BASELINE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <PackageReference Include="InputSimulatorCore" Version="1.0.5" />
    <PackageReference Include="Melanchall.DryWetMidi" Version="8.0.3" />
    <PackageReference Include="MouseKeyHook" Version="5.7.1" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="$(SourceRoot)\KeySimulator.cs" Link="Production\KeySimulator.cs" />
    <Compile Include="$(SourceRoot)\InputTracker.cs" Link="Production\InputTracker.cs" />
    <Compile Include="$(SourceRoot)\SettingsManager.cs" Link="Production\SettingsManager.cs" />
    <Compile Include="$(SourceRoot)\MidiNoteHelper.cs" Link="Production\MidiNoteHelper.cs" />
    <Compile Include="$(SourceRoot)\MidiListener.cs" Link="Production\MidiListener.cs" />
    <Compile Include="$(SourceRoot)\HotkeyManager.cs" Link="Production\HotkeyManager.cs" />
    <Compile Include="$(SourceRoot)\HotkeyConfigDialog.cs" Link="Production\HotkeyConfigDialog.cs" />
    <Compile Include="$(SourceRoot)\DiagnosticLogger.cs" Link="Production\DiagnosticLogger.cs" />
    <Compile Include="$(SourceRoot)\MidiDeviceDiagnostics.cs" Link="Production\MidiDeviceDiagnostics.cs" />
    <Compile Include="$(SourceRoot)\WinRtMidiWatcher.cs" Link="Production\WinRtMidiWatcher.cs" />
    <Compile Include="$(SourceRoot)\LatencyMeasurement.cs" Link="Production\LatencyMeasurement.cs" Condition="Exists('$(SourceRoot)\LatencyMeasurement.cs')" />
  </ItemGroup>
</Project>
