<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.7.0" />
    <PackageReference Include="MSTest.TestFramework" Version="3.7.0" />
    <PackageReference Include="InputSimulatorCore" Version="1.0.5" />
    <PackageReference Include="Melanchall.DryWetMidi" Version="8.0.3" />
    <PackageReference Include="MouseKeyHook" Version="5.7.1" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\KeySimulator.cs" Link="KeySimulator.cs" />
    <Compile Include="..\..\InputTracker.cs" Link="InputTracker.cs" />
    <Compile Include="..\..\SettingsManager.cs" Link="SettingsManager.cs" />
    <Compile Include="..\..\MidiNoteHelper.cs" Link="MidiNoteHelper.cs" />
    <Compile Include="..\..\MidiListener.cs" Link="MidiListener.cs" />
    <Compile Include="..\..\HotkeyManager.cs" Link="HotkeyManager.cs" />
    <Compile Include="..\..\HotkeyConfigDialog.cs" Link="HotkeyConfigDialog.cs" />
    <Compile Include="..\..\DiagnosticLogger.cs" Link="DiagnosticLogger.cs" />
    <Compile Include="..\..\MidiDeviceDiagnostics.cs" Link="MidiDeviceDiagnostics.cs" />
    <Compile Include="..\..\WinRtMidiWatcher.cs" Link="WinRtMidiWatcher.cs" />
    <Compile Include="..\..\MidiPortProbeService.cs" Link="MidiPortProbeService.cs" />
    <Compile Include="..\..\SingleInstance.cs" Link="SingleInstance.cs" />
    <Compile Include="..\..\AppIcons.cs" Link="AppIcons.cs" />
    <EmbeddedResource Include="..\..\assets\*.ico" LogicalName="MidiToKeyApp.Assets.%(Filename)%(Extension)" />
    <Compile Include="..\..\Form1.cs" Link="Form1.cs" />
    <Compile Include="..\..\MidiListenerLifecycle.cs" Link="MidiListenerLifecycle.cs" Condition="Exists('..\..\MidiListenerLifecycle.cs')" />
    <Compile Include="..\..\LatencyMeasurement.cs" Link="LatencyMeasurement.cs" Condition="Exists('..\..\LatencyMeasurement.cs')" />
    <Compile Include="..\..\InputWarmup.cs" Link="InputWarmup.cs" Condition="Exists('..\..\InputWarmup.cs')" />
  </ItemGroup>

</Project>
