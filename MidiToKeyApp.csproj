<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>midi2key</AssemblyName>
    <Version>1.2.0</Version>
    <AssemblyVersion>1.2.0</AssemblyVersion>
    <FileVersion>1.2.0</FileVersion>
    
    <!-- 単一ファイル化の強化設定 -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests\**" />
    <None Remove="tests\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="InputSimulatorCore" Version="1.0.5" />
    <PackageReference Include="Melanchall.DryWetMidi" Version="8.0.3" />
    <PackageReference Include="MouseKeyHook" Version="5.7.1" />
  </ItemGroup>

  <!-- DryWetMIDI includes its macOS binary as an unconditional None item. -->
  <Target Name="RemoveMacDryWetMidiBinary" BeforeTargets="AssignTargetPaths"
          Condition="'$(TargetPlatformIdentifier)' == 'Windows'">
    <ItemGroup>
      <None Remove="@(None)" Condition="'%(None.Filename)%(None.Extension)' == 'Melanchall_DryWetMidi_Native64.dylib'" />
    </ItemGroup>
  </Target>

  <Target Name="CleanOldMacDryWetMidiBinary" AfterTargets="CopyFilesToOutputDirectory;Publish"
          Condition="'$(TargetPlatformIdentifier)' == 'Windows'">
    <Delete Files="$(TargetDir)Melanchall_DryWetMidi_Native64.dylib;$(PublishDir)Melanchall_DryWetMidi_Native64.dylib" />
  </Target>

  <PropertyGroup>
    <CreateWindowsReleaseArchive Condition="'$(OS)' == 'Windows_NT' and '$(Configuration)' == 'Release' and '$(RuntimeIdentifier)' == 'win-x64' and '$(SelfContained)' == 'true' and '$(PublishSingleFile)' == 'true'">true</CreateWindowsReleaseArchive>
  </PropertyGroup>

  <Target Name="RemovePreviousWindowsReleaseArchive" BeforeTargets="Restore;Build;Publish"
          Condition="'$(CreateWindowsReleaseArchive)' == 'true'">
    <Delete Files="$(PublishDir)midi2key.zip" />
  </Target>

  <Target Name="CreateWindowsReleaseArchive" AfterTargets="Publish"
          Condition="'$(CreateWindowsReleaseArchive)' == 'true'">
    <Exec Command="powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\package-publish.ps1&quot; -Executable &quot;$(PublishDir)midi2key.exe&quot; -Archive &quot;$(PublishDir)midi2key.zip&quot;" />
  </Target>

</Project>
